# Local mode needs no keys. The PostgreSQL schema is a migration target, not the local adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comiclingo
DATA_DIR=.data
LLM_PROVIDER=mock
# Optional OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
